# Base de datos PostgreSQL (RDS)
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${RDS_HOST}:5432/kiri_finance?schema=public&sslmode=require"

# JWT
JWT_SECRET="CHANGE_THIS_IN_PRODUCTION"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="CHANGE_THIS_IN_PRODUCTION"
JWT_REFRESH_EXPIRES_IN="30d"

# Server
PORT=4000
NODE_ENV=production

# Frontend URL (para CORS) — separar múltiples orígenes con coma
FRONTEND_URL="https://kiri.cyclonet.com.co"

# Disable CORS in production (Nginx handles it)
DISABLE_CORS=true
