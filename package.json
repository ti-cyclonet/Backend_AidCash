{
  "name": "backend-kiri",
  "version": "1.0.0",
  "description": "Kiri Finance Backend - API REST con Express + Prisma + PostgreSQL",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
