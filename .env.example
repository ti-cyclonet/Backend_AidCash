# Base de datos PostgreSQL
DATABASE_URL="postgresql://usuario:password@localhost:5432/kiri_finance?schema=public"

# JWT
JWT_SECRET="tu_secreto_jwt_super_seguro_aqui"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="otro_secreto_para_refresh_tokens"
JWT_REFRESH_EXPIRES_IN="30d"

# Server
PORT=4000
NODE_ENV=development

# Frontend URL (para CORS)
# Asegúrate de que coincida con el puerto real del frontend
# Next.js dev en este proyecto corre en puerto 9002
FRONTEND_URL="http://localhost:9002"

# Google AI (para Genkit flows)
GOOGLE_GENAI_API_KEY="tu_api_key_de_google_ai"

# Web Push (VAPID keys — generar con: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_EMAIL="mailto:admin@kiri.app"

# Correo de destino para los tickets de soporte (formulario "Soporte" del perfil)
SUPPORT_EMAIL_TO="ti.cyclonet@hotmail.com"
