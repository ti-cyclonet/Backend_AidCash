// Kiri Finance - Schema de Base de Datos
// PostgreSQL con Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Usuario ──────────────────────────────────────────────────────────────────

model User {
  id                    String   @id @default(uuid())
  nombre                String
  correo                String   @unique
  // @username público para buscarse entre usuarios (Social) — se autogenera del
  // nombre al registrarse, editable después desde Perfil.
  username              String   @unique
  avatarUrl             String?  @map("avatar_url") // foto de perfil en base64
  passwordHash          String   @map("password_hash")
  ingresoBase           Decimal  @default(0) @map("ingreso_base") @db.Decimal(12, 2)
  frecuenciaIngreso     String   @default("mensual") @map("frecuencia_ingreso")
  diasPago              Int[]    @default([]) @map("dias_pago")
  onboardingDone        Boolean  @default(false) @map("onboarding_done")
  metaAhorroGlobal      Decimal  @default(5000) @map("meta_ahorro_global") @db.Decimal(12, 2)
  saldoAhorroTotal      Decimal  @default(0) @map("saldo_ahorro_total") @db.Decimal(12, 2)
  fondoEmergenciaActual Decimal  @default(0) @map("fondo_emergencia_actual") @db.Decimal(12, 2)
  streakActual          Int      @default(0) @map("streak_actual")
  streakMejor           Int      @default(0) @map("streak_mejor")
  streakUltimoCheck     DateTime? @map("streak_ultimo_check") @db.Date
  // Misiones — XP acumulado por misiones reclamadas, y boost temporal (x2 XP) activo
  xpFromMissions        Int      @default(0) @map("xp_from_missions")
  xpBoostExpiresAt      DateTime? @map("xp_boost_expires_at")
  cashBalance           Decimal  @default(0) @map("cash_balance") @db.Decimal(12, 2)
  // Wallet — saldo real distribuido en 4 bolsillos
  walletAhorro          Decimal  @default(0) @map("wallet_ahorro") @db.Decimal(12, 2)
  walletObligaciones    Decimal  @default(0) @map("wallet_obligaciones") @db.Decimal(12, 2)
  walletLibre           Decimal  @default(0) @map("wallet_libre") @db.Decimal(12, 2)
  walletEndeudamiento   Decimal  @default(0) @map("wallet_endeudamiento") @db.Decimal(12, 2)
  isActive              Boolean  @default(true) @map("is_active")
  // Bienvenida pendiente tras activación de plan pago (para mostrar notificación in-app)
  pendingWelcome        String?  @map("pending_welcome")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  // Relaciones existentes
  debts                 Debt[]
  fixedExpenses         FixedExpense[]
  savingsHistory        SavingsHistory[]
  extraIncomes          ExtraIncome[]
  impulseExpenses       ImpulseExpense[]
  emergencyFundHistory  EmergencyFundHistory[]
  badges                UserBadge[]
  missionProgress       MissionProgress[]
  rewardClaims          RewardClaim[]
  refreshTokens         RefreshToken[]
  incomeRecords         IncomeRecord[]
  pushSubscriptions     PushSubscription[]

  // Bolsillos de ahorro personales y categorías de presupuesto
  savingsPockets        SavingsPocket[]
  budgetCategories      BudgetCategory[]

  // Open Banking — Belvo
  belvoLinks            BelvoLink[]

  // Relaciones Phase 3 — Social
  sentConnections       Connection[]       @relation("ConnectionRequester")
  receivedConnections   Connection[]       @relation("ConnectionAddressee")
  sharedPocketMembers   SharedPocketMember[]
  loansGiven            Loan[]             @relation("LoanLender")
  loansReceived         Loan[]             @relation("LoanBorrower")
  coOwnedDebts          Debt[]             @relation("DebtCoOwner")

  // Fase 4 — Social gamificado: riego de jardines entre amigos
  wateringsGiven        GardenWatering[]   @relation("WaterGiven")
  wateringsReceived     GardenWatering[]   @relation("WaterReceived")

  @@map("users")
}

// ─── Tokens de refresco ───────────────────────────────────────────────────────

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ─── Deudas ───────────────────────────────────────────────────────────────────

// ─── Tipo de deuda ─────────────────────────────────────────────────────────────

enum TipoDeuda {
  PRESTAMO
  TARJETA_CREDITO
}

model Debt {
  id                String     @id @default(uuid())
  userId            String     @map("user_id")
  nombre            String
  tipoDeuda         TipoDeuda  @default(PRESTAMO) @map("tipo_deuda")
  montoTotal        Decimal    @map("monto_total") @db.Decimal(12, 2)
  montoInicial      Decimal?   @map("monto_inicial") @db.Decimal(12, 2)
  saldoRestante     Decimal    @map("saldo_restante") @db.Decimal(12, 2)
  saldoPrincipal    Decimal?   @map("saldo_principal") @db.Decimal(12, 2)
  cuotaPeriodo      Decimal    @map("cuota_periodo") @db.Decimal(12, 2)
  tasaInteres       Decimal?   @map("tasa_interes") @db.Decimal(5, 2)
  tasaInteresAplicada Decimal? @map("tasa_interes_aplicada") @db.Decimal(7, 4)
  tasaInteresMensual Decimal?  @map("tasa_interes_mensual") @db.Decimal(7, 4)
  diaCorte          Int?       @map("dia_corte")
  acreedor          String     @default("")
  frecuenciaPago    String     @default("mensual") @map("frecuencia_pago")
  diasPago          String     @default("1") @map("dias_pago")
  estado            String     @default("activa") // activa | saldada | vencida
  prioridad         String     @default("media") // alta | media | baja
  vencidoDesde      DateTime?  @map("vencido_desde")
  fechaInicio       DateTime?  @map("fecha_inicio") @db.Date
  bankEntityId      String?    @map("bank_entity_id")
  coOwnerId         String?    @map("co_owner_id")
  pagoAutomatico    Boolean    @default(false) @map("pago_automatico")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  coOwner          User?         @relation("DebtCoOwner", fields: [coOwnerId], references: [id], onDelete: SetNull)
  bankEntity       BankEntity?   @relation(fields: [bankEntityId], references: [id], onDelete: SetNull)
  payments         DebtPayment[]
  gastosVinculados FixedExpense[] @relation("TarjetaVinculada")
  cardInstallments DebtCardInstallment[] @relation("TarjetaInstallments")

  @@map("debts")
}

// ─── Planes de cuotas cargados a una tarjeta (pay-with-card) ──────────────────
// Cada compra/pago diferido a cuotas queda como una fila acá en vez de mutar
// Debt.cuotaPeriodo directamente. La cuota EFECTIVA de la tarjeta se calcula en
// el momento (GET /debts) sumando solo los planes cuyos meses transcurridos
// desde createdAt sean menores a cuotasTotal — mismo patrón "periodo, sin cron"
// que el resto de la app: cuando un plan termina, deja de sumar solo, sin que
// nada tenga que borrarlo ni resetearlo.

model DebtCardInstallment {
  id           String   @id @default(uuid())
  tarjetaId    String   @map("tarjeta_id")
  cuotaMensual Decimal  @map("cuota_mensual") @db.Decimal(12, 2)
  cuotasTotal  Int      @map("cuotas_total")
  descripcion  String?
  createdAt    DateTime @default(now()) @map("created_at")

  tarjeta Debt @relation("TarjetaInstallments", fields: [tarjetaId], references: [id], onDelete: Cascade)

  @@index([tarjetaId])
  @@map("debt_card_installments")
}

// ─── Historial de pagos de deuda (amortización) ───────────────────────────────

model DebtPayment {
  id             String   @id @default(uuid())
  debtId         String   @map("debt_id")
  montoPagado    Decimal  @map("monto_pagado") @db.Decimal(12, 2)
  abonoCapital   Decimal  @map("abono_capital") @db.Decimal(12, 2)
  pagoInteres    Decimal  @map("pago_interes") @db.Decimal(12, 2)
  saldoAnterior  Decimal  @map("saldo_anterior") @db.Decimal(12, 2)
  saldoPosterior Decimal  @map("saldo_posterior") @db.Decimal(12, 2)
  periodo        String
  createdAt      DateTime @default(now()) @map("created_at")

  debt Debt @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@map("debt_payments")
}

// ─── Entidades Bancarias (colaborativa) ───────────────────────────────────────

model BankEntity {
  id                  String   @id @default(uuid())
  nombre              String   @unique
  tasaInteresPromedio Decimal  @map("tasa_interes_promedio") @db.Decimal(7, 4)
  esVerificado        Boolean  @default(false) @map("es_verificado")
  // Campos para integración Open Banking (Belvo)
  apiProvider         String?  @map("api_provider")       // "belvo" | "plaid" | null
  providerItemId      String?  @map("provider_item_id")   // ID del link en el proveedor
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  debts Debt[]

  @@map("bank_entities")
}

// ─── Gastos Fijos ─────────────────────────────────────────────────────────────

model FixedExpense {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  nombre            String
  monto             Decimal @db.Decimal(12, 2)
  categoria         String  @default("otro")
  fechaCorte        String  @map("fecha_corte")
  frecuencia        String  @default("mensual")
  metodoPago        String? @map("metodo_pago")
  renovacionAuto    Boolean @default(false) @map("renovacion_auto")
  // Vinculación a tarjeta de crédito (al pagar, suma al saldo de la tarjeta)
  tarjetaVinculadaId String? @map("tarjeta_vinculada_id")
  pagoAutomatico    Boolean @default(false) @map("pago_automatico")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user             User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tarjetaVinculada Debt? @relation("TarjetaVinculada", fields: [tarjetaVinculadaId], references: [id], onDelete: SetNull)
  payments         FixedExpensePayment[]

  @@map("fixed_expenses")
}

// ─── Historial de pagos de gasto fijo (ledger por periodo, espejo de DebtPayment) ─

model FixedExpensePayment {
  id             String   @id @default(uuid())
  fixedExpenseId String   @map("fixed_expense_id")
  montoPagado    Decimal  @map("monto_pagado") @db.Decimal(12, 2)
  periodo        String
  createdAt      DateTime @default(now()) @map("created_at")

  fixedExpense FixedExpense @relation(fields: [fixedExpenseId], references: [id], onDelete: Cascade)

  @@index([fixedExpenseId, periodo])
  @@map("fixed_expense_payments")
}

// ─── Historial de Ahorro ──────────────────────────────────────────────────────

model SavingsHistory {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  periodo   String
  monto     Decimal  @db.Decimal(12, 2)
  tipo      String   // ahorro | sin_ahorro
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("savings_history")
}

// ─── Ingresos Extra ───────────────────────────────────────────────────────────

model ExtraIncome {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  nombre          String
  monto           Decimal   @db.Decimal(12, 2)
  temporalidad    String    // una_vez | definido | indefinido
  mesesRestantes  Int?      @map("meses_restantes")
  fechaRecepcion  DateTime? @map("fecha_recepcion") @db.Date
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("extra_incomes")
}

// ─── Gastos Hormiga ───────────────────────────────────────────────────────────

model ImpulseExpense {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  nombre    String
  monto     Decimal  @db.Decimal(12, 2)
  categoria String   @default("otro") // cafe | comida | transporte | antojo | salida | otro
  periodo   String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, periodo])
  @@map("impulse_expenses")
}

// ─── Fondo de Emergencia - Historial ──────────────────────────────────────────

model EmergencyFundHistory {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  periodo   String
  monto     Decimal  @db.Decimal(12, 2)
  tipo      String   // aporte | retiro
  nota      String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("emergency_fund_history")
}

// ─── Insignias del Usuario ────────────────────────────────────────────────────

model UserBadge {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  badgeId    String   @map("badge_id")
  unlockedAt DateTime @default(now()) @map("unlocked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("user_badges")
}

// ─── Misiones diarias/semanales — progreso y reclamos de recompensa ──────────

model MissionProgress {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  missionKey String    @map("mission_key") // gasto_hormiga | pagar_obligacion | categorizar | racha_semanal
  periodo    String    // "2026-08-29" (diarias) o "2026-W35" (semanal)
  progress   Int       @default(0)
  target     Int
  claimedAt  DateTime? @map("claimed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, missionKey, periodo])
  @@index([userId, periodo])
  @@map("mission_progress")
}

model RewardClaim {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  missionKey  String   @map("mission_key")
  periodo     String
  rewardType  String   @map("reward_type") // xp | boost
  rewardValue Int      @map("reward_value") // monto de XP, u horas de boost
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("reward_claims")
}

// ─── Registro de Ingresos Reales (Flujo de Caja) ──────────────────────────────

model IncomeRecord {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  monto     Decimal  @db.Decimal(12, 2)
  tipo      String   // salario | extra
  // Distribución aplicada al registrar
  aAhorro         Decimal  @default(0) @map("a_ahorro") @db.Decimal(12, 2)
  aObligaciones   Decimal  @default(0) @map("a_obligaciones") @db.Decimal(12, 2)
  aLibre          Decimal  @default(0) @map("a_libre") @db.Decimal(12, 2)
  aEndeudamiento  Decimal  @default(0) @map("a_endeudamiento") @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("income_records")
}

// ─── Push Subscriptions (Web Push) ────────────────────────────────────────────

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_subscriptions")
}

// ─── Open Banking — Belvo Links & Transacciones ──────────────────────────────

model BelvoLink {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  linkId          String   @unique @map("link_id")         // ID del link en Belvo
  institution     String                                    // Nombre del banco conectado
  institutionType String   @default("bank") @map("institution_type") // bank | fiscal
  accessMode      String   @default("recurrent") @map("access_mode") // single | recurrent
  status          String   @default("valid")               // valid | invalid | unconfirmed
  lastSyncAt      DateTime? @map("last_sync_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts     BelvoAccount[]
  transactions BelvoTransaction[]

  @@map("belvo_links")
}

model BelvoAccount {
  id              String   @id @default(uuid())
  belvoLinkId     String   @map("belvo_link_id")
  accountId       String   @unique @map("account_id")    // ID de la cuenta en Belvo
  nombre          String
  tipo            String                                  // checking | savings | credit_card | loan
  numero          String?                                 // últimos 4 dígitos
  moneda          String   @default("COP")
  balanceActual   Decimal  @default(0) @map("balance_actual") @db.Decimal(14, 2)
  balanceDisponible Decimal? @map("balance_disponible") @db.Decimal(14, 2)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  belvoLink BelvoLink @relation(fields: [belvoLinkId], references: [id], onDelete: Cascade)

  @@map("belvo_accounts")
}

model BelvoTransaction {
  id              String   @id @default(uuid())
  belvoLinkId     String   @map("belvo_link_id")
  transactionId   String   @unique @map("transaction_id") // ID en Belvo (evitar duplicados)
  accountId       String   @map("account_id")
  fecha           DateTime @db.Date
  monto           Decimal  @db.Decimal(14, 2)
  tipo            String                                   // INFLOW | OUTFLOW
  categoria       String?                                  // categoría de Belvo
  descripcion     String?
  comercio        String?                                  // nombre del comercio
  status          String   @default("PROCESSED")           // PENDING | PROCESSED
  createdAt       DateTime @default(now()) @map("created_at")

  belvoLink BelvoLink @relation(fields: [belvoLinkId], references: [id], onDelete: Cascade)

  @@index([belvoLinkId, fecha])
  @@map("belvo_transactions")
}

// ─── Bolsillos de Ahorro Personales ───────────────────────────────────────────

model SavingsPocket {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  nombre       String
  meta         Decimal  @default(0) @db.Decimal(12, 2)
  montoActual  Decimal  @default(0) @map("monto_actual") @db.Decimal(12, 2)
  color        String   @default("#10B981")
  icono        String   @default("piggy-bank")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("savings_pockets")
}

// ─── Categorías de Presupuesto ────────────────────────────────────────────────

model BudgetCategory {
  id                    String   @id @default(uuid())
  userId                String   @map("user_id")
  nombre                String
  icono                 String   @default("tag")
  color                 String   @default("#6366F1")
  tipo                  String   @default("gasto") // gasto | ingreso | ahorro
  montoLimite           Decimal  @default(0) @map("monto_limite") @db.Decimal(12, 2)
  linkedFixedExpenseIds String[] @default([]) @map("linked_fixed_expense_ids")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("budget_categories")
}

// ─── Phase 3: Social ──────────────────────────────────────────────────────────

// Rol de la conexión social
enum ConnectionRole {
  FRIEND
  FAMILY
  PARTNER
}

// Conexión / invitación entre usuarios
model Connection {
  id          String         @id @default(uuid())
  requesterId String         @map("requester_id")
  addresseeId String         @map("addressee_id")
  // PENDING | ACCEPTED | REJECTED
  status      String         @default("PENDING")
  role        ConnectionRole @default(FRIEND)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  requester User @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("ConnectionAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@map("connections")
}

// Bolsillo de ahorro compartido (multiusuario — soporta pareja, familia, amigos)
model SharedPocket {
  id          String   @id @default(uuid())
  nombre      String
  balance     Decimal  @default(0) @db.Decimal(12, 2)
  meta        Decimal  @default(0) @db.Decimal(12, 2)
  deadline    String?  // texto libre, ej. "Antes del 15 de diciembre" — mismo patrón que Loan.dueDate
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members   SharedPocketMember[]
  deposits  SharedDeposit[]

  @@map("shared_pockets")
}

// Miembros de un bolsillo compartido (tabla relacional N:M)
model SharedPocketMember {
  id             String   @id @default(uuid())
  sharedPocketId String   @map("shared_pocket_id")
  userId         String   @map("user_id")
  role           String   @default("member") // owner | member
  joinedAt       DateTime @default(now()) @map("joined_at")

  sharedPocket SharedPocket @relation(fields: [sharedPocketId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sharedPocketId, userId])
  @@map("shared_pocket_members")
}

// Depósitos individuales al bolsillo compartido
model SharedDeposit {
  id             String   @id @default(uuid())
  sharedPocketId String   @map("shared_pocket_id")
  userId         String   @map("user_id")
  monto          Decimal  @db.Decimal(12, 2)
  nota           String?
  createdAt      DateTime @default(now()) @map("created_at")

  sharedPocket SharedPocket @relation(fields: [sharedPocketId], references: [id], onDelete: Cascade)

  @@map("shared_deposits")
}

// Préstamo P2P entre usuarios conectados
model Loan {
  id              String   @id @default(uuid())
  lenderId        String   @map("lender_id")
  borrowerId      String   @map("borrower_id")
  amount          Decimal  @db.Decimal(12, 2)
  remainingAmount Decimal  @map("remaining_amount") @db.Decimal(12, 2)
  descripcion     String?
  dueDate         String?  @map("due_date")
  // PENDING_APPROVAL | PENDING_BORROWER_CONFIRMATION | ACTIVE | REJECTED | PAID
  status          String   @default("PENDING_APPROVAL")
  // Tasa de interés aplicada por el prestamista (0, 5, 10, etc.)
  tasaInteres     Decimal? @map("tasa_interes") @db.Decimal(5, 2)
  // Monto original sin intereses (para referencia)
  montoOriginal   Decimal? @map("monto_original") @db.Decimal(12, 2)
  // Referencia al gasto hormiga que originó el split (opcional)
  sourceExpenseId String?  @map("source_expense_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  lender   User          @relation("LoanLender",   fields: [lenderId],   references: [id], onDelete: Cascade)
  borrower User          @relation("LoanBorrower",  fields: [borrowerId], references: [id], onDelete: Cascade)
  payments LoanPayment[]

  @@map("loans")
}

// Abono/pago parcial de un préstamo
model LoanPayment {
  id        String   @id @default(uuid())
  loanId    String   @map("loan_id")
  userId    String   @map("user_id")   // quien realiza el abono (borrower)
  monto     Decimal  @db.Decimal(12, 2)
  nota      String?
  // PENDING_CONFIRMATION | CONFIRMED | REJECTED
  status    String   @default("PENDING_CONFIRMATION")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@map("loan_payments")
}

// ─── Fase 4: Riego de jardines entre amigos ──────────────────────────────────
// Mismo patrón `periodo` que MissionProgress (Fase 3) — sin cron, la fila del
// día se crea/consulta al vuelo. El unique constraint es el guard real de
// "máximo 1 vez por conexión por día", validado en el servidor.

model GardenWatering {
  id           String   @id @default(uuid())
  waterId      String   @map("water_id")       // quién riega
  targetUserId String   @map("target_user_id") // a quién le riegan
  periodo      String                           // "2026-08-30"
  createdAt    DateTime @default(now()) @map("created_at")

  water      User @relation("WaterGiven", fields: [waterId], references: [id], onDelete: Cascade)
  targetUser User @relation("WaterReceived", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([waterId, targetUserId, periodo])
  @@index([targetUserId, periodo])
  @@map("garden_watering")
}
